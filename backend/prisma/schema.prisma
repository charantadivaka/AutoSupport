// Prisma schema for AI Customer Support Automation Platform
// Supports PostgreSQL with pgvector for semantic retrieval

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum ConversationStatus {
  ACTIVE
  WAITING_AGENT
  RESOLVED
}

enum MessageSender {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  conversations      Conversation[]
  assignedTickets    Ticket[]            @relation("AssignedAgent")
  createdTickets     Ticket[]            @relation("CustomerTickets")
  uploadedDocuments  KnowledgeDocument[]
  feedbacks          Feedback[]

  @@map("users")
}

model Conversation {
  id         String             @id @default(uuid()) @db.Uuid
  customerId String             @db.Uuid
  status     ConversationStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  customer User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  tickets  Ticket[]

  @@index([customerId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  sender         MessageSender
  content        String        @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources      MessageSource[]
  feedback     Feedback?

  @@index([conversationId])
  @@map("messages")
}

model KnowledgeDocument {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  originalFilename String
  filePath         String
  processingStatus ProcessingStatus @default(PENDING)
  processingError  String?          @db.Text
  createdBy        String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  creator User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  chunks  DocumentChunk[]

  @@index([createdBy])
  @@index([processingStatus])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  chunkIndex Int
  content    String   @db.Text
  pageNumber Int?
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sources  MessageSource[]

  @@index([documentId])
  @@map("document_chunks")
}

model Ticket {
  id                  String         @id @default(uuid()) @db.Uuid
  conversationId      String?        @db.Uuid
  customerId          String         @db.Uuid
  assignedAgentId     String?        @db.Uuid
  subject             String
  description         String         @db.Text
  category            String         @default("General")
  priority            TicketPriority @default(MEDIUM)
  status              TicketStatus   @default(OPEN)
  conversationSummary String?        @db.Text
  resolutionNotes     String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  resolvedAt          DateTime?

  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer      User          @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent User?         @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model MessageSource {
  id              String   @id @default(uuid()) @db.Uuid
  messageId       String   @db.Uuid
  documentChunkId String   @db.Uuid
  relevanceScore  Float
  createdAt       DateTime @default(now())

  message       Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentChunk DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([documentChunkId])
  @@map("message_sources")
}

model Feedback {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @unique @db.Uuid
  customerId String   @db.Uuid
  // Bug #28 fix: Rating uses 1–5 CSAT star scale (clamped in tickets.service.ts).
  // The old comment saying "1 for thumbs up, -1 for thumbs down" was wrong and contradicted
  // the actual implementation. There is no binary thumbs system in this codebase.
  rating     Int      // 1–5 CSAT star rating (1 = very poor, 5 = excellent)
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("feedback")
}

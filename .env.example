# ==============================================================================
# AutoSupport AI - Environment Configuration (.env.example)
# Copy this file to .env or .env.local and populate with your own credentials
# ==============================================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL with pgvector extension)
# Docker Compose default uses port 5433 to avoid conflicts with existing local Postgres:
DATABASE_URL="postgresql://autosupport:autosupport_dev_password@localhost:5433/autosupport_db?schema=public"
# If using a local native PostgreSQL on port 5432:
# DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/autosupport_db?schema=public"

# Authentication & Session Security
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRES_IN="7d"

# AI / LLM Service Configuration (Backend only - never exposed to frontend)
# Supported providers: "openai" | "gemini" | "anthropic" | "mock"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-google-ai-studio-api-key"
OPENAI_API_KEY="your-openai-api-key"
EMBEDDING_MODEL="text-embedding-004"
CHAT_MODEL="gemini-1.5-flash"
LLM_TIMEOUT_MS=20000
LLM_RETRY_ATTEMPTS=2
LOG_LEVEL=info

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
